# Copy to .env. Use your Neon pooled connection for runtime.
DATABASE_URL=""
# Direct Neon connection for migrations.
DIRECT_URL=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set only temporarily when running owner:create. Never commit credentials.
OWNER_EMAIL=""
OWNER_NAME=""
OWNER_PASSWORD=""
RECOVERY_CONFIRM_EMAIL=""
# Local storage for development or a persistent single-host deployment.
# Use cloudinary or s3 on Vercel. All objects must remain private.
STORAGE_DRIVER="cloudinary"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
# AWS SDK supports these credentials or the host's IAM role.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
